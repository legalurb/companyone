companyone.com.br {
	root * /etc/caddy/sites/companyone/site
	encode gzip zstd

	# registro de acesso por 6 meses (Marco Civil da Internet, art. 15), sem cookies nem origem
	log {
		output file /data/logs/companyone-acesso.log {
			roll_size 50MiB
			roll_keep 400
			roll_keep_for 4392h
		}
		format filter {
			request>headers>Cookie delete
			request>headers>Authorization delete
			request>headers>Referer delete
			resp_headers>Set-Cookie delete
			wrap json
		}
	}

	@estatico path /assets/*
	header @estatico Cache-Control "public, max-age=2592000"

	# as páginas são sempre conferidas com o servidor: mudou no GitHub, mudou para quem abre
	@paginas {
		not path /assets/* /e
	}
	header @paginas Cache-Control "no-cache"

	# contagem de visitas e cliques (sem cookies): o pedido só deixa uma linha no registro acima
	@evento path /e
	header @evento Cache-Control "no-store"
	respond @evento 204

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}

	file_server
}

www.companyone.com.br {
	redir https://companyone.com.br{uri} permanent
}
